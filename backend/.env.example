# ============================================
# Backend — Supabase Edge Function gizli değişkenleri
# ============================================
# DİKKAT: Bunlar bir .env dosyasına değil, Supabase panelinden
# (Edge Functions → Secrets) gizli değişken olarak girilir.
# Gerçek anahtarlar ASLA repoya yüklenmez.

# Google Gemini API anahtarı (AI özellikleri için)
GEMINI_API_KEY=your-gemini-api-key-here

# Aşağıdakiler Supabase tarafından otomatik sağlanır (elle girmene gerek yok):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
